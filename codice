<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KID Advisory | Simulatore Costi Bancari</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #0f172a; color: #f8fafc; margin: 0; padding: 20px; }
    .card { max-width: 650px; margin: 0 auto; background: #1e293b; border-radius: 12px; padding: 24px; box-shadow: 0 10px 25px rgba(0,0,0,0.3); }
    h2 { margin-top: 0; font-size: 1.3rem; text-align: center; color: #38bdf8; }
    .control-group { margin-bottom: 18px; }
    label { display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 6px; color: #94a3b8; }
    input[type=range] { width: 100%; accent-color: #38bdf8; cursor: pointer; }
    .metric-container { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 20px 0; }
    .metric { background: #0f172a; padding: 12px; border-radius: 8px; text-align: center; }
    .metric span { display: block; font-size: 0.8rem; color: #94a3b8; }
    .metric strong { font-size: 1.2rem; }
    .red { color: #f87171; }
    .green { color: #4ade80; }
    .cta-box { margin-top: 20px; padding: 14px; background: rgba(56, 189, 248, 0.1); border: 1px solid #38bdf8; border-radius: 8px; text-align: center; font-size: 0.85rem; }
  </style>
</head>
<body>

<div class="card">
  <h2>Simulatore Costi: Banca vs Strumenti Diretti</h2>

  <div class="control-group">
    <label>Capitale investito: <strong id="valCapital" style="color:#fff">20.000 €</strong></label>
    <input type="range" id="capital" min="2000" max="100000" step="1000" value="20000">
  </div>

  <div class="control-group">
    <label>Costi fondo banca (% annuo): <strong id="valFee" style="color:#fff">2.4%</strong></label>
    <input type="range" id="fee" min="0.5" max="4.0" step="0.1" value="2.4">
  </div>

  <div class="control-group">
    <label>Orizzonte temporale: <strong id="valYears" style="color:#fff">10 anni</strong></label>
    <input type="range" id="years" min="1" max="25" step="1" value="10">
  </div>

  <div class="metric-container">
    <div class="metric">
      <span>Regalato alla Banca:</span>
      <strong id="lostCapital" class="red">- 4.316 €</strong>
    </div>
    <div class="metric">
      <span>Risparmio Netto Recuperabile:</span>
      <strong id="savedCapital" class="green">+ 3.924 €</strong>
    </div>
  </div>

  <canvas id="chartCanvas" height="180"></canvas>

  <div class="cta-box">
    <strong>Vuoi verificare il prospetto del tuo fondo?</strong><br>
    Invia il documento KID in forma anonima a <u>info@kidadvisory.it</u> per l'Audit del Venerdì.
  </div>
</div>

<script>
  const capitalInput = document.getElementById('capital');
  const feeInput = document.getElementById('fee');
  const yearsInput = document.getElementById('years');

  const valCapital = document.getElementById('valCapital');
  const valFee = document.getElementById('valFee');
  const valYears = document.getElementById('valYears');

  const lostCapitalEl = document.getElementById('lostCapital');
  const savedCapitalEl = document.getElementById('savedCapital');

  const ctx = document.getElementById('chartCanvas').getContext('2d');
  let chart;

  function calculate() {
    const C = parseFloat(capitalInput.value);
    const fee = parseFloat(feeInput.value) / 100;
    const Y = parseInt(yearsInput.value);

    valCapital.textContent = C.toLocaleString('it-IT') + ' €';
    valFee.textContent = (fee * 100).toFixed(1) + '%';
    valYears.textContent = Y + ' anni';

    const labels = [];
    const bankCosts = [];
    const directCosts = [];

    for (let t = 0; t <= Y; t++) {
      labels.push('Anno ' + t);
      const bCost = C * (1 - Math.pow(1 - fee, t));
      const dCost = C * (1 - Math.pow(1 - 0.002, t));
      bankCosts.push(Math.round(bCost));
      directCosts.push(Math.round(dCost));
    }

    const totalBank = bankCosts[Y];
    const totalDirect = directCosts[Y];
    const saved = totalBank - totalDirect;

    lostCapitalEl.textContent = '- ' + totalBank.toLocaleString('it-IT') + ' €';
    savedCapitalEl.textContent = '+ ' + saved.toLocaleString('it-IT') + ' €';

    if (chart) chart.destroy();

    chart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [
          { label: 'Commissioni Banca', data: bankCosts, borderColor: '#f87171', backgroundColor: 'rgba(248, 113, 113, 0.15)', fill: true, tension: 0.2 },
          { label: 'Strumenti Diretti (0,20%)', data: directCosts, borderColor: '#38bdf8', backgroundColor: 'transparent', borderDash: [4, 4], tension: 0.2 }
        ]
      },
      options: {
        responsive: true,
        plugins: { legend: { labels: { color: '#94a3b8' } } },
        scales: {
          x: { ticks: { color: '#64748b' }, grid: { color: 'rgba(255,255,255,0.05)' } },
          y: { ticks: { color: '#64748b' }, grid: { color: 'rgba(255,255,255,0.05)' } }
        }
      }
    });
  }

  [capitalInput, feeInput, yearsInput].forEach(el => el.addEventListener('input', calculate));
  calculate();
</script>
</body>
</html>
